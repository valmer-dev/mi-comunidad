# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave publica (publishable / anon). Puede estar en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Clave secreta (service_role). NUNCA debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx

# URL publica de la app (para enlaces en correos y metadatos)
NEXT_PUBLIC_URL_APP=http://localhost:3000

# Avisos por correo (opcional). Sin esto los avisos solo se ven en la app.
# Opcion 1, Resend (necesita un dominio verificado en Resend):
# RESEND_API_KEY=re_xxxxxxxx
# CORREO_REMITENTE="Mi Comunidad <avisos@tudominio.es>"
# Opcion 2, SMTP; con Gmail basta usuario y contrasena de aplicacion:
# SMTP_USUARIO=tucuenta@gmail.com
# SMTP_CONTRASENA=xxxx xxxx xxxx xxxx
# SMTP_SERVIDOR=smtp.gmail.com
# SMTP_PUERTO=465
